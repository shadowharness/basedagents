+    if page.body.capacity() < needed { page.body.reserve_exact(needed); }
+    page.body.extend_from_slice(b"{\"ok\":true,\"tasks\":[");
+    for (i, row) in page.rows.iter().enumerate() {
+        if i != 0 { page.body.push(b','); }
