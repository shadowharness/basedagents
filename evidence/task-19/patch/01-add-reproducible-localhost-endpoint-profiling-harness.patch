diff --git a/bench/README.md b/bench/README.md
new file mode 100644
index 0000000..cdea1b6
--- /dev/null
+++ b/bench/README.md
@@ -0,0 +1,21 @@
+# Local API endpoint benchmark
+
+This harness runs the unmodified API routes against synthetic data in the repository's Node/SQLite configuration. It serves only `127.0.0.1` on an ephemeral port. The client has a literal loopback destination; no production URL can be supplied. Payment, analytics, email and webhook credentials are absent, and server-side `fetch` is disabled. No fixture identity, signature, chain hash or transaction hash represents a real agent or payment.
+
+Prerequisites: Linux arm64, Node 22.23.3, npm, a C++ build toolchain for `better-sqlite3`. The recorded environment uses two shared CPU cores and a 2 GiB memory limit. Install the pinned lockfile from the repository root:
+
+```sh
+npm ci --no-audit --no-fund
+npm run build:dist --workspace=@basedagents/keyring
+node bench/run.mjs baseline-01 full
+```
+
+Use a new run label each time. Existing fixtures and server logs are not overwritten. Results are written beside the repository under `../runs/<label>/`. `smoke` can replace `full` for a wiring check; smoke timings are not evidence of an optimization.
+
+`workload.json` fixes the dataset, five HTTP paths, concurrency, warmup and sample counts. Each endpoint receives 120 warmup requests, five batches of 400 measured requests at concurrency four, then a separate 400-request profiling pass. HTTP latency runs exclude profiler instrumentation; their measurements end when the whole response body has arrived. Responses must be HTTP 200 and retain the same JSON hash throughout the run. Only the status response's `checked_at` and `db_latency_ms` diagnostics are removed from that hash. The first normalized response is saved for cross-version comparisons.
+
+The server applies the complete upstream migration chain to a fresh SQLite fixture, then inserts 2,000 agents, 50,000 tasks and 100,000 verifications with fixed timestamps. Tasks are evenly distributed across five lifecycle states; half the verified tasks carry synthetic settled payments. This is a reproducible scale fixture, not a claim about production traffic or data distribution.
+
+Each endpoint has a standard V8 `.cpuprofile` plus SQL timing/counts and `EXPLAIN QUERY PLAN` artifacts. SQL timing measures synchronous Node SQLite invocation, including prepare and step, and excludes Promise scheduling of other requests. Profiling is a separate workload pass; it must not supply the reported latency numbers. Raw request latencies and all batch results remain in `results.json`; report medians and spread across batches along with p50 and p99.
+
+Keep workload, data, hardware, runtime, server logging and measurement code identical across source changes. Run the repository's `npm test` after each optimization commit, preserve the command and complete output, and compare response hashes. Since the host CPU is shared, repeat an unchanged baseline after the optimized measurements to check environmental drift. Record unsuccessful experiments along with successful changes.
diff --git a/bench/run.mjs b/bench/run.mjs
new file mode 100644
index 0000000..83fb18b
--- /dev/null
+++ b/bench/run.mjs
@@ -0,0 +1,95 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import os from 'node:os';
+import http from 'node:http';
+import { spawn, execFileSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { performance } from 'node:perf_hooks';
+import { createHash } from 'node:crypto';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const [label, mode = 'full'] = process.argv.slice(2);
+if (!/^[a-z0-9-]+$/.test(label || '') || !['full','smoke'].includes(mode)) throw new Error('Use run.mjs label [full|smoke]');
+const workloadBytes = fs.readFileSync(path.join(root, 'bench/workload.json'));
+const workload = JSON.parse(workloadBytes);
+const output = path.resolve(root, '../runs', label);
+fs.mkdirSync(output, { recursive: true });
+const sha = bytes => createHash('sha256').update(bytes).digest('hex');
+const metadata = { at: new Date().toISOString(), mode, upstreamHead: execFileSync('git', ['rev-parse','HEAD'], { cwd: root, encoding: 'utf8' }).trim(),
+  platform: process.platform, arch: process.arch, node: process.version, cpu: os.cpus()[0].model, availableParallelism: os.availableParallelism(),
+  workload, workloadSha256: sha(workloadBytes), sourceSha256: {} };
+for (const filename of ['bench/server.ts','bench/run.mjs','packages/api/src/index.ts','packages/api/src/db/sqlite-adapter.ts','packages/api/src/tasks/service.ts','packages/api/src/tasks/settled.ts']) metadata.sourceSha256[filename] = sha(fs.readFileSync(path.join(root, filename)));
+fs.writeFileSync(path.join(output, 'metadata.json'), JSON.stringify(metadata, null, 2));
+const log = fs.openSync(path.join(output, 'server.log'), 'wx');
+const child = spawn(process.execPath, ['--import', 'tsx', 'bench/server.ts'], { cwd: root, stdio: ['ignore',log,log,'ipc'],
+  env: { PATH: process.env.PATH, HOME: process.env.HOME, BENCH_OUTPUT: output, NODE_ENV: 'production' } });
+function waitFor(type) {
+  return new Promise((resolve, reject) => {
+    const timer = setTimeout(() => { cleanup(); reject(new Error(`Timed out waiting for ${type}`)); }, 120000);
+    const exit = code => { cleanup(); reject(new Error(`Server exited ${code} waiting for ${type}`)); };
+    const message = data => { if (data.type === type) { cleanup(); resolve(data); } else if (data.type === 'error') { cleanup(); reject(new Error(data.message)); } };
+    function cleanup() { clearTimeout(timer); child.off('message', message); child.off('exit', exit); }
+    child.on('message', message); child.on('exit', exit);
+  });
+}
+const agent = new http.Agent({ keepAlive: true, maxSockets: workload.concurrency });
+let port;
+const fingerprints = new Map();
+function request(endpoint) {
+  const start = performance.now();
+  return new Promise((resolve, reject) => {
+    const req = http.request({ hostname: '127.0.0.1', port, path: endpoint.path, method: 'GET', agent }, response => {
+      const chunks = [];
+      response.on('data', chunk => chunks.push(chunk));
+      response.on('error', reject);
+      response.on('end', () => {
+        const ms = performance.now() - start, body = Buffer.concat(chunks);
+        try {
+          if (response.statusCode !== 200) throw new Error(`Unexpected status ${response.statusCode}: ${body}`);
+          const parsed = JSON.parse(body.toString());
+          // These two status diagnostics vary with wall time, not API behavior.
+          if (endpoint.name === 'status') { delete parsed.checked_at; delete parsed.db_latency_ms; }
+          const fingerprint = sha(JSON.stringify(parsed));
+          if (fingerprints.has(endpoint.name) && fingerprints.get(endpoint.name) !== fingerprint) throw new Error(`Response changed during fixed run: ${endpoint.name}`);
+          if (!fingerprints.has(endpoint.name)) fs.writeFileSync(path.join(output, `${endpoint.name}.response.json`), JSON.stringify(parsed, null, 2));
+          fingerprints.set(endpoint.name, fingerprint); resolve(ms);
+        } catch (error) { reject(error); }
+      });
+    });
+    req.setTimeout(30000, () => req.destroy(new Error('HTTP request timed out')));
+    req.on('error', reject); req.end();
+  });
+}
+async function load(endpoint, count) {
+  const times = []; let next = 0;
+  const start = performance.now();
+  await Promise.all(Array.from({ length: workload.concurrency }, async () => {
+    while (next++ < count) times.push(await request(endpoint));
+  }));
+  const elapsedMs = performance.now() - start;
+  const sorted = [...times].sort((a,b) => a-b);
+  const quantile = p => sorted[Math.ceil(p * sorted.length) - 1];
+  return { count: times.length, elapsedMs, requestsPerSecond: count * 1000 / elapsedMs, p50: quantile(.5), p99: quantile(.99), timesMs: times };
+}
+try {
+  ({ port } = await waitFor('ready'));
+  const results = [];
+  for (const endpoint of workload.endpoints) {
+    await load(endpoint, mode === 'smoke' ? 8 : workload.warmupRequests);
+    const runs = [];
+    for (let run = 0; run < (mode === 'smoke' ? 1 : workload.runs); run++) runs.push(await load(endpoint, mode === 'smoke' ? 12 : workload.measuredRequests));
+    const med = xs => [...xs].sort((a,b) => a-b)[Math.floor(xs.length/2)];
+    const item = { endpoint, runs, medianP50: med(runs.map(r=>r.p50)), medianP99: med(runs.map(r=>r.p99)), responseSha256: fingerprints.get(endpoint.name) };
+    results.push(item);
+    if (mode === 'full') {
+      const started = waitFor('profile-started'); child.send({ type: 'profile-start' }); await started;
+      await load(endpoint, workload.profileRequests);
+      const stopped = waitFor('profile-stopped'); child.send({ type: 'profile-stop', name: endpoint.name }); await stopped;
+    }
+    fs.writeFileSync(path.join(output, 'results.json'), JSON.stringify(results, null, 2));
+    console.log(JSON.stringify({ endpoint: endpoint.name, p50: item.medianP50, p99: item.medianP99, responseSha256: item.responseSha256 }));
+  }
+  fs.writeFileSync(path.join(output, 'complete.json'), JSON.stringify({ completedAt: new Date().toISOString(), endpoints: results.length, requestsFailed: 0 }));
+} finally {
+  agent.destroy(); child.send({ type: 'stop' });
+  setTimeout(() => child.kill('SIGTERM'), 5000).unref();
+}
diff --git a/bench/server.ts b/bench/server.ts
new file mode 100644
index 0000000..6655b7b
--- /dev/null
+++ b/bench/server.ts
@@ -0,0 +1,102 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createHash } from 'node:crypto';
+import { performance } from 'node:perf_hooks';
+import inspector from 'node:inspector';
+import { serve } from '@hono/node-server';
+import { initDatabase } from '../packages/api/src/db/index.js';
+import { runnerMigrationFiles, RUNNER_LOCAL_STATEMENTS } from '../packages/api/src/db/migration-list.js';
+import { SQLiteAdapter } from '../packages/api/src/db/sqlite-adapter.js';
+import app, { setNodeAdapter } from '../packages/api/src/index.js';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const output = process.env.BENCH_OUTPUT;
+if (!output || !process.send) throw new Error('Use bench/run.mjs; IPC and output directory required');
+fs.mkdirSync(output, { recursive: true });
+const dbFile = path.join(output, 'fixture.sqlite');
+if (fs.existsSync(dbFile)) throw new Error('Do not overwrite an existing run fixture');
+const sqlite = initDatabase(dbFile);
+for (const name of runnerMigrationFiles(path.join(root, 'packages/api/migrations'))) {
+  sqlite.transaction(() => sqlite.exec(fs.readFileSync(path.join(root, 'packages/api/migrations', name), 'utf8')))();
+}
+for (const sql of RUNNER_LOCAL_STATEMENTS) sqlite.exec(sql);
+const workload = JSON.parse(fs.readFileSync(path.join(root, 'bench/workload.json'), 'utf8'));
+const id = (i: number) => `ag_benchmark_${String(i).padStart(5, '0')}`;
+const iso = (i: number) => new Date(Date.UTC(2026, 0, 1) + i * 1000).toISOString();
+const digest = (s: string) => createHash('sha256').update(s).digest('hex');
+const agentInsert = sqlite.prepare(`INSERT INTO agents (id, public_key, name, description, capabilities, protocols, status, registered_at, reputation_score) VALUES (?,?,?,?,?,?,?,?,?)`);
+const taskInsert = sqlite.prepare(`INSERT INTO tasks (task_id, creator_agent_id, creator_kind, claimed_by_agent_id, title, description, category, required_capabilities, output_format, status, created_at, claimed_at, submitted_at, verified_at, accepted_by, bounty_amount, bounty_token, bounty_network, payment_status, payment_settled, payment_tx_hash, settled_at, rating, rating_context, rated_at) VALUES (${Array(25).fill('?').join(',')})`);
+const verificationInsert = sqlite.prepare(`INSERT INTO verifications (id, verifier_id, target_id, result, coherence_score, signature, created_at) VALUES (?,?,?,?,?,?,?)`);
+const chainInsert = sqlite.prepare(`INSERT INTO chain (entry_hash, previous_hash, agent_id, public_key, nonce, profile_hash, timestamp) VALUES (?,?,?,?,?,?,?)`);
+sqlite.transaction(() => {
+  for (let i = 0; i < workload.dataset.agents; i++) {
+    const key = Buffer.from(digest(`public-fixture-${i}`), 'hex');
+    agentInsert.run(id(i), key, `Benchmark-${String(i).padStart(4, '0')}`, `Synthetic benchmark agent ${i}`, '["code","testing"]', '["https"]', i % 10 ? 'active' : 'pending', iso(i), (i % 100) / 100);
+    chainInsert.run(digest(`entry-${i}`), digest(`entry-${i - 1}`), id(i), key, `fixture-${i}`, digest(`profile-${i}`), iso(i));
+  }
+  for (let i = 0; i < workload.dataset.tasks; i++) {
+    const status = ['open', 'claimed', 'submitted', 'verified', 'cancelled'][i % 5];
+    const paid = status === 'verified' && i % 2 === 0;
+    const claimed = status !== 'open';
+    const submitted = status === 'submitted' || status === 'verified';
+    const verified = status === 'verified';
+    taskInsert.run(`task_benchmark_${String(i).padStart(6, '0')}`, id(i % 2000), 'agent', claimed ? id((i + 1) % 2000) : null,
+      `Synthetic task ${i}`, 'Deterministic public-only performance fixture. '.repeat(10), i % 2 ? 'code' : 'research', '["code"]', 'json', status,
+      iso(i), claimed ? iso(i + 10) : null, submitted ? iso(i + 20) : null, verified ? iso(i + 30) : null, verified ? 'creator' : null,
+      paid ? '1000000' : null, paid ? 'USDC' : null, paid ? 'eip155:8453' : null, paid ? 'settled' : 'none', paid ? 1 : 0,
+      paid ? `0x${digest(`local-only-tx-${i}`)}` : null, paid ? iso(i + 40) : null, verified ? (i % 5) + 1 : null, verified ? 'accept' : null, verified ? iso(i + 30) : null);
+  }
+  for (let i = 0; i < workload.dataset.verifications; i++) {
+    verificationInsert.run(`fixture-verification-${i}`, id(i % 2000), id((i + 1) % 2000), 'pass', 0.9, 'public-fixture-not-a-real-signature', iso(i));
+  }
+})();
+sqlite.pragma('wal_checkpoint(TRUNCATE)');
+const adapter = new SQLiteAdapter(sqlite);
+let profiling = false;
+let queries = new Map<string, { method: string; sql: string; count: number; totalMs: number; maxMs: number; params: unknown[] }>();
+for (const method of ['get', 'all', 'run'] as const) {
+  const original = adapter[method].bind(adapter);
+  (adapter as any)[method] = (sql: string, ...params: unknown[]) => {
+    if (!profiling) return original(sql, ...params);
+    const start = performance.now();
+    // SQLiteAdapter executes prepare/step synchronously before returning its Promise.
+    // Time that invocation, excluding unrelated requests' microtask scheduling.
+    try { return original(sql, ...params); }
+    finally {
+      const ms = performance.now() - start, key = method + ':' + sql;
+      const item = queries.get(key) || { method, sql, count: 0, totalMs: 0, maxMs: 0, params };
+      item.count++; item.totalMs += ms; item.maxMs = Math.max(item.maxMs, ms); queries.set(key, item);
+    }
+  };
+}
+setNodeAdapter(adapter);
+// All data is synthetic. No networked payment, analytics, webhook or email environment is passed.
+const env = { TASK_PAYMENTS_ENABLED: '0', TASK_ESCROW_ENABLED: '0' };
+globalThis.fetch = (async () => { throw new Error('Benchmark server external fetch is disabled'); }) as typeof fetch;
+const session = new inspector.Session(); session.connect();
+const post = (method: string, params: object = {}) => new Promise<any>((resolve, reject) => session.post(method as any, params, (error, result) => error ? reject(error) : resolve(result)));
+const server = serve({ fetch: req => app.fetch(req, env), hostname: '127.0.0.1', port: 0 }, info => process.send?.({ type: 'ready', port: info.port, dataset: workload.dataset }));
+process.on('message', async (message: any) => {
+  try {
+    if (message.type === 'profile-start') {
+      queries = new Map();
+      await post('Profiler.enable'); await post('Profiler.setSamplingInterval', { interval: 100 });
+      await post('Profiler.start'); profiling = true;
+      process.send?.({ type: 'profile-started' });
+    } else if (message.type === 'profile-stop') {
+      profiling = false;
+      const { profile } = await post('Profiler.stop');
+      const entries = [...queries.values()].sort((a, b) => b.totalMs - a.totalMs).map(entry => {
+        let plan: unknown;
+        try { plan = sqlite.prepare('EXPLAIN QUERY PLAN ' + entry.sql).all(...entry.params); } catch { plan = null; }
+        return { ...entry, plan };
+      });
+      fs.writeFileSync(path.join(output, `${message.name}.cpuprofile`), JSON.stringify(profile));
+      fs.writeFileSync(path.join(output, `${message.name}.sql.json`), JSON.stringify(entries, null, 2));
+      process.send?.({ type: 'profile-stopped' });
+    } else if (message.type === 'stop') {
+      server.close(() => { session.disconnect(); sqlite.close(); process.exit(0); });
+    }
+  } catch (error) { process.send?.({ type: 'error', message: String(error) }); }
+});
diff --git a/bench/workload.json b/bench/workload.json
new file mode 100644
index 0000000..faac730
--- /dev/null
+++ b/bench/workload.json
@@ -0,0 +1,16 @@
+{
+  "schema": 1,
+  "dataset": { "agents": 2000, "tasks": 50000, "verifications": 100000 },
+  "concurrency": 4,
+  "warmupRequests": 120,
+  "measuredRequests": 400,
+  "runs": 5,
+  "profileRequests": 400,
+  "endpoints": [
+    { "name": "tasks-open", "path": "/v1/tasks?status=open&limit=100" },
+    { "name": "tasks-verified", "path": "/v1/tasks?status=verified&limit=100" },
+    { "name": "agent-profile", "path": "/v1/agents/Benchmark-0001" },
+    { "name": "status", "path": "/v1/status" },
+    { "name": "chain", "path": "/v1/chain" }
+  ]
+}
